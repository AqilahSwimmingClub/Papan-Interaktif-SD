# Provider dipilih Admin di aplikasi; secret berikut hanya dipasang pada server/Vercel.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Endpoint publik aplikasi native tetap hanya menunjuk server sendiri, bukan provider.
VITE_AI_ENDPOINT=/api/ai/generate
